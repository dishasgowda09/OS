PROGRAM RR:

#include <stdio.h>
int main() {
    int n, bt[20], rem[20], wt[20]={0};
    int tat[20], q, t=0, i, done;
    float awt=0, atat=0;

    scanf("%d", &n);
    for(i=0; i<n; i++) scanf("%d", &bt[i]), rem[i]=bt[i];
    scanf("%d", &q);

    if(q<=0) return 1;

    do {
        done=1;
        for(i=0; i<n; i++)
            if(rem[i]>0) {
                done=0;
                if(rem[i]>q) t+=q, rem[i]-=q;
                else t+=rem[i], rem[i]=0, tat[i]=t,
                     wt[i]=tat[i]-bt[i];
            }
    } while(!done);

    for(i=0; i<n; i++) {
        awt+=wt[i]; atat+=tat[i];
        printf("WT=%d TAT=%d\n", wt[i], tat[i]);
    }

    printf("Average WT=%.2f\nAverage TAT=%.2f",
           awt/n, atat/n);
    return 0;
}
