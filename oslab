#include <stdio.h>
int main() {
    int n, bt[20], wt[20], tat[20], i, j, t;
    float awt=0, atat=0;

    scanf("%d", &n);
    for(i=0; i<n; i++) bt[i]=i+1, scanf("%d", &bt[i]);

    for(i=0; i<n-1; i++)
        for(j=0; j<n-i-1; j++)
            if(bt[j]>bt[j+1]) {
                t=bt[j]; bt[j]=bt[j+1]; bt[j+1]=t;
            }

    wt[0]=0;
    for(i=1; i<n; i++) wt[i]=wt[i-1]+bt[i-1];

    for(i=0; i<n; i++) {
        tat[i]=wt[i]+bt[i];
        awt+=wt[i]; atat+=tat[i];
        printf("WT=%d TAT=%d\n", wt[i], tat[i]);
    }

    printf("Average WT=%.2f\nAverage TAT=%.2f",
           awt/n, atat/n);
    return 0;
}

