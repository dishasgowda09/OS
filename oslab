#include <stdio.h>
#include <pthread.h>
 
void *print_message(void *arg) {
   char *message = (char *) arg;
   int i;
   for (i = 0; i < 3; i++)
       printf("Thread [%s]: iteration %d\n", message, i + 1);
   pthread_exit(NULL);
}
 
int main() {
   pthread_t t1, t2;
 
   pthread_create(&t1, NULL, print_message, (void *) "Thread-1");
   pthread_create(&t2, NULL, print_message, (void *) "Thread-2");
 
   pthread_join(t1, NULL);
   pthread_join(t2, NULL);
 
   printf("Both threads have finished execution.\n");
   return 0;
}

PROGRAM 5:
#include <stdio.h>
 
struct Process {
   int pid, bt, wt, tat, pr;
};
 
void findFCFS(struct Process p[], int n) {
   p[0].wt = 0;
   int i;
   for (i = 1; i < n; i++)
       p[i].wt = p[i - 1].wt + p[i - 1].bt;
   for (i = 0; i < n; i++)
       p[i].tat = p[i].wt + p[i].bt;
}
 
void findSJF(struct Process p[], int n) {
   struct Process temp;
   int i, j;
   for (i = 0; i < n - 1; i++)
       for (j = 0; j < n - i - 1; j++)
           if (p[j].bt > p[j + 1].bt) {
               temp = p[j]; p[j] = p[j + 1]; p[j + 1] = temp;
           }
   findFCFS(p, n);
}
 
void findPriority(struct Process p[], int n) {
   struct Process temp;
   int i, j;
   for (i = 0; i < n - 1; i++)
       for (j = 0; j < n - i - 1; j++)
           if (p[j].pr > p[j + 1].pr) {
               temp = p[j]; p[j] = p[j + 1]; p[j + 1] = temp;
           }
   findFCFS(p, n);
}
 
void findRoundRobin(struct Process p[], int n, int quantum) {
   int rem_bt[20], t = 0, i, done;
   for (i = 0; i < n; i++) rem_bt[i] = p[i].bt;
 
   do {
       done = 1;
       for (i = 0; i < n; i++) {
           if (rem_bt[i] > 0) {
               done = 0;
               if (rem_bt[i] > quantum) {
                   t += quantum;
                   rem_bt[i] -= quantum;
               } else {
                   t += rem_bt[i];
                   p[i].wt = t - p[i].bt;
                   rem_bt[i] = 0;
               }
           }
       }
   } while (!done);
 
   for (i = 0; i < n; i++)
       p[i].tat = p[i].wt + p[i].bt;
}
 
void printResult(struct Process p[], int n) {
   float total_wt = 0, total_tat = 0;
   int i;
   printf("PID\tBurst\tWait\tTurnaround\n");
   for (i = 0; i < n; i++) {
       printf("%d\t%d\t%d\t%d\n", p[i].pid, p[i].bt, p[i].wt, p[i].tat);
       total_wt += p[i].wt;
       total_tat += p[i].tat;
   }
   printf("Average Waiting Time    : %.2f\n", total_wt / n);
   printf("Average Turnaround Time : %.2f\n", total_tat / n);
}
 
int main() {
   int n, choice, quantum, i;
   struct Process p[20];
 
   printf("Enter number of processes: ");
   scanf("%d", &n);
 
   for (i = 0; i < n; i++) {
       p[i].pid = i + 1;
       printf("Enter burst time for P%d: ", i + 1);
       scanf("%d", &p[i].bt);
       printf("Enter priority for P%d (lower = higher priority): ", i + 1);
       scanf("%d", &p[i].pr);
   }
 
   printf("\n1. FCFS  2. SJF  3. Priority  4. Round Robin\nEnter choice: ");
   scanf("%d", &choice);
 
   switch (choice) {
       case 1: findFCFS(p, n); break;
       case 2: findSJF(p, n); break;
       case 3: findPriority(p, n); break;
       case 4:
           printf("Enter time quantum: ");
           scanf("%d", &quantum);
           findRoundRobin(p, n, quantum);
           break;
       default:
           printf("Invalid choice\n");
           return 1;
   }
 
   printResult(p, n);
   return 0;
}

PROGRAM FCFS:

#include <stdio.h>
int main() {
    int n, bt[20], wt[20], tat[20], i;
    float awt = 0, atat = 0;

    scanf("%d", &n);
    for(i=0; i<n; i++) scanf("%d", &bt[i]);

    wt[0] = 0;
    for(i=1; i<n; i++) wt[i] = wt[i-1] + bt[i-1];

    for(i=0; i<n; i++) {
        tat[i] = wt[i] + bt[i];
        awt += wt[i];
        atat += tat[i];
        printf("P%d WT=%d TAT=%d\n", i+1, wt[i], tat[i]);
    }

    printf("Average WT=%.2f\nAverage TAT=%.2f",
           awt/n, atat/n);
    return 0;
}


